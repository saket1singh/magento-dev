<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="MageMonk_SearchDesign::css/search.css"/>
    </head>
    <body>
        <referenceBlock name="top.search">
            <action method="setTemplate">
                <argument name="template" xsi:type="string">MageMonk_SearchDesign::form.mini.phtml</argument>
            </action>
            <arguments>
                <argument name="searchDesignConfig" xsi:type="object">MageMonk\SearchDesign\ViewModel\SearchConfig</argument>
            </arguments>
        </referenceBlock>
    </body>
</page>
