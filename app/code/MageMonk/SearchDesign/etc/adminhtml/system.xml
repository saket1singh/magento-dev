<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="magemonk" translate="label" sortOrder="300">
            <label>MageMonk</label>
        </tab>
        <section id="searchdesign" translate="label" sortOrder="900" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Search Design</label>
            <tab>magemonk</tab>
            <resource>MageMonk_SearchDesign::config</resource>
            <group id="general" translate="label" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Search Suggestions</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Enable the custom search suggestion dropdown and styling.</comment>
                </field>
            </group>
        </section>
    </system>
</config>
